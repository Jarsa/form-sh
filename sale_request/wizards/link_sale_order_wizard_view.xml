<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_link_sale_order_wizard_form" model="ir.ui.view">
    <field name="name">view.link.sale.order.wizard.form</field>
    <field name="model">link.sale.order.wizard</field>
    <field name="arch" type="xml">
      <form string="Enlazar Líneas a Pedido Master">
        <sheet>
          <!-- Título -->
          <group string="Seleccione las líneas del pedido master"/>

          <!-- Campos ocultos -->
          <group>
            <field name="partner_id"  invisible="1"/>
            <field name="product_ids" invisible="1"/>
          </group>

          <!-- Líneas ya en master order -->
          <group string="Líneas del Pedido Master">
            <field name="line_ids" nolabel="1" colspan="4">
              <tree editable="top" create="0" delete="0">
                <field name="product_id"            force_save="1"/>
                <field name="name"                  force_save="1"/>
                <field name="product_uom_qty"       force_save="1"/>
                <field name="product_uom_id"        force_save="1"/>
                <field name="remaining_product_qty" force_save="1"/>
                <field name="sale_line_id" invisible="1" force_save="1"/>
              </tree>
            </field>
          </group>

          <!-- Líneas disponibles para enlazar -->
          <group string="Líneas no enlazadas">
            <field name="sale_line_ids"
                   nolabel="1"
                   create="0"  
                   colspan="4"
                   domain="[
                     ('product_id','in',product_ids),
                     ('master_sale_order','=',False),
                     ('parent_id','=',False),
                     ('order_id.partner_id','=',partner_id),
                     ('product_uom_qty','>',0.0),
                     ('order_id.state','!=','cancel'),
                     ('invoice_status','!=','invoiced')
                   ]"
                   options="{'no_create': True}">
              <tree create="1">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_uom_qty"/>
              </tree>
            </field>
          </group>
        </sheet>

        <footer>
          <button name="link_sale_order"
                  string="Confirmar"
                  type="object"
                  class="oe_highlight"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_link_sale_order" model="ir.actions.act_window">
        <field name="name">Link Sale Orders to Master Sale Order</field>
        <field name="res_model">link.sale.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        
    </record>
</odoo>