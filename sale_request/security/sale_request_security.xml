<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_sale_request">
        <field name="name">Sale Request</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_sale_request_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="category_id" ref="module_category_sale_request"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_sale_request_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('sale_request.group_sale_request_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="category_id" ref="module_category_sale_request"/>
    </record>

    <record id="group_allow_request_no_stock" model="res.groups">
        <field name="name">Allow to create sale requests with no stock</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- TODOS LOS USUARIOS AÑADIDOS A LOS GRUPOS AUTOMÁTICAMENTE -->
    <function model="res.groups" name="write">
        <value model="res.groups" search="[('id', '=', ref('group_sale_request_user'))]"/>
        <value eval="{'users': [(4, user.id) for user in env['res.users'].search([('active', '=', True)])]}"/>
    </function>

    <function model="res.groups" name="write">
        <value model="res.groups" search="[('id', '=', ref('group_allow_request_no_stock'))]"/>
        <value eval="{'users': [(4, user.id) for user in env['res.users'].search([('active', '=', True)])]}"/>
    </function>

    <!-- Dar acceso al menú de ventas a todos los usuarios -->
    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record model="ir.rule" id="sale_request_comp_rule">
        <field name="name">Sale Request multi-company</field>
        <field name="model_id" ref="model_sale_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id','=',False),
            ('company_id','child_of',[user.company_id.id])]</field>
    </record>

    <!-- REGLA ÚNICA PERMISIVA PARA TODOS LOS USUARIOS -->
    <record id="sale_request_all_users_rule" model="ir.rule">
        <field name="name">Sale Request All Users Access</field>
        <field name="model_id" ref="model_sale_request"/>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
