<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_master_sale_order_search_inherit" model="ir.ui.view">
        <field name="name">sale.report.search.inherit</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Exclude Master Sale Orders"
                        domain="[('master_sale_order','=',False)]"
                        name="master_sale_order_filter"/>
            </xpath>
        </field>
    </record>
</odoo>
