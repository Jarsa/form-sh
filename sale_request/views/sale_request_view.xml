<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record model="ir.ui.view" id="view_sale_request_tree">
        <field name="name">view.sale.request.tree</field>
        <field name="model">sale.request</field>
        <field name="arch" type="xml">
            <tree string="Sale Request">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="requested_by"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record model="ir.ui.view" id="view_sale_request_form">
        <field name="name">view.sale.request.form</field>
        <field name="model">sale.request</field>
        <field name="arch" type="xml">
            <form string="Sale Request">
                <header>
                    <button name="button_draft"
                            modifiers="cancel"
                            string="Reset"
                            type="object"
                            class="btn-primary"
                            groups="sale_request.group_sale_request_manager"/>
                    <button name="button_confirm"
                            modifiers="draft"
                            string="Confirm"
                            type="object"
                            class="oe_highlight"
                            groups="sale_request.group_sale_request_manager"/>
                    <field name="state" widget="statusbar" nolabel="1"/>
                    <button name="button_cancel"
                            modifiers="draft,confirm"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            groups="sale_request.group_sale_request_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button"
                                name="button_sale_orders"
                                string="Sales"
                                type="object"
                                icon="fa-usd"
                                modifiers="{'invisible': [('sale_ids', '=', [])]}"/>
                        <button class="oe_stat_button"
                                name="button_sale_request_lines"
                                string="Request Lines"
                                type="object"
                                icon="fa-bars"/>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="partner_id" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="partner_shipping_id" modifiers="{'readonly': [('state', '!=', 'draft')], 'required': True}"/>
                        </group>
                        <group>
                            <field name="date" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="company_id" company_dependent="True" groups="base.group_multi_company"/>
                            <field name="warehouse_id" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="route_id" groups="sale_request.group_allow_request_no_stock" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <group>
                        <group name="users">
                            <field name="requested_by" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Lines">
                            <group>
                                <field name="line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="product_id" modifiers="{'readonly': [('request_state', '!=', 'draft')]}"/>
                                        <field name="description" modifiers="{'readonly': [('request_state', '!=', 'draft')]}"/>
                                        <field name="product_qty" modifiers="{'readonly': [('request_state', '!=', 'draft')]}"/>
                                        <field name="remaining_product_qty"/>
                                        <field name="product_uom_id" groups="uom.group_uom" modifiers="{'readonly': [('request_state', '!=', 'draft')]}"/>
                                        <field name="category_uom_id" groups="uom.group_uom" invisible="1"/>
                                        <field name="request_state" invisible="1"/>
                                        <field name="request_id" invisible="1"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page name="description" string="Extra Information">
                            <group>
                                <field name="description" nolabel="1" modifiers="{'readonly': [('state', '!=', 'draft')]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_sale_request_search" model="ir.ui.view">
        <field name="name">view.sale.request.search</field>
        <field name="model">sale.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <filter name="requested_by" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_confirm" string="Confirmed" domain="[('state', '=', 'confirm')]"/>
                <filter name="state_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="My Activities" name="activities_my" domain="[('activity_ids.user_id', '=', uid)]"/>
                <filter string="Late Activities" name="activities_overdue" domain="[('activity_ids.date_deadline', '&lt;', context_today())]"/>
                <filter string="Today Activities" name="activities_today" domain="[('activity_ids.date_deadline', '=', context_today())]"/>
                <filter string="Future Activities" name="activities_upcoming_all" domain="[('activity_ids.date_deadline', '&gt;', context_today())]"/>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_sale_request" model="ir.actions.act_window">
        <field name="name">Sale Request</field>
        <field name="res_model">sale.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_sale_request_line" model="ir.actions.act_window">
        <field name="name">Sale Request Lines</field>
        <field name="res_model">sale.request.line</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False, 'edit': False}</field>
    </record>

    <!-- Menus -->
    <menuitem id="sale_request_main_menu" name="Sale Requests" parent="sale.sale_menu_root" sequence="3"/>
    <menuitem id="sale_request_menu" name="Sale Requests" parent="sale_request_main_menu" action="action_sale_request" sequence="1"/>
    <menuitem id="sale_request_line_menu" name="Sale Request Lines" parent="sale_request_main_menu" action="action_sale_request_line" sequence="2"/>
</odoo>
