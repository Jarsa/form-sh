<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record model="ir.ui.view" id="view_sale_order_unified_form">
    <field name="name">view.sale.order.unified.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="priority" eval="20"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_id']" position="before">
            <field name="master_sale_order" invisible="1"/>
        </xpath>

      <!-- 1) Replace the standard order_line tree with the unified version -->
      <xpath expr="//page[@name='order_lines']//field[@name='order_line']/tree" position="replace">
        <tree string="Sales Order Lines" editable="bottom">
          <!-- Common fields -->
          <field name="product_id"/>
          <field name="name"/>
          <field name="product_uom_qty"/>
          <field name="qty_delivered"/>
          <field name="qty_invoiced"/>
          <field name="product_uom"/>
          <field name="price_unit"/>
          <field name="tax_id" widget="many2many_tags"/>
          <field name="discount" groups="product.group_discount_per_so_line"/>
          <field name="price_subtotal"/>

          
          <field name="product_uom_category_id" optional="hide"/>
          <field name="state" optional="hide"/>
          <field name="currency_id" optional="hide"/>
          <field name="company_id" optional="hide"/>
        </tree>
      </xpath>

      <!-- 2) Insert a new page AFTER order_lines for master_sale_order_line -->
      <xpath expr="//page[@name='order_lines']" position="after">
        <page name="master_sale_order_line" string="Master Sales Order Lines"
              modifiers="{'invisible':[('master_sale_order','=',False)]}">
          <field name="master_sale_order_line">
            <tree string="Master Sales Order Lines" editable="bottom">
              <!-- Reuse the same columns to keep parity -->
              <field name="product_id"/>
              <field name="name"/>
              <field name="product_uom_qty"/>
              <field name="qty_delivered"/>
              <field name="product_uom_qty_total" />
              <field name="remaining_product_qty"/>
              <field name="qty_delivered_total" />
              <field name="qty_invoiced_total" />
              <field name="product_uom"/>
              <field name="price_unit"/>
              <field name="tax_id" widget="many2many_tags"/>
              <field name="discount" groups="product.group_discount_per_so_line"/>
              <field name="price_subtotal"/>

              <!-- Master totals -->

              <!-- Hidden/system fields -->
              <field name="master_sale_order" optional="hide"/>
              <field name="child_ids" optional="hide"/>
              <field name="request_line_id" optional="hide"/>
              <field name="product_template_id" optional="hide"/>
              <field name="product_packaging_id" optional="hide"/>
              <field name="product_packaging_qty" optional="hide"/>
              <field name="product_uom_category_id" optional="hide"/>
              <field name="state" optional="hide"/>
              <field name="order_partner_id" optional="hide"/>
              <field name="salesman_id" optional="hide"/>
              <field name="currency_id" optional="hide"/>
              <field name="company_id" optional="hide"/>
            </tree>
          </field>
          
          <!-- Totals section after Master Sale Order Lines -->
          <group name="studio_group_one">
            <group name="studio_group_1lo_left"/>
            <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                <field name="amount_untaxed" string="Subtotal:" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="amount_tax" string="IVA 16%:" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <div class="oe_subtotal_footer_separator oe_inline">
                <label for="amount_total" string="Total:"/>
                </div>
                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <!--field name="margin" string="Margen:" widget="monetary" options="{'currency_field': 'currency_id'}"/-->
            </group>
          </group>
        </page>
      </xpath>

      <!-- 3) Buttons (placed OUTSIDE of other xpath blocks) -->
      <xpath expr="//button[@name='action_confirm']" position="after">
        <button name="button_link_sale_order"
                string="Link Sale Order"
                type="object"
                class="oe_highlight"
                modifiers="{'invisible':[('master_sale_order','=',False)]}"/>
      </xpath>

      <xpath expr="//button[@name='action_view_invoice']" position="after">
        <button class="oe_stat_button"
                name="button_child_sale_orders"
                string="Sale Orders"
                type="object"
                icon="fa-bars"
                modifiers="{'invisible':[('master_sale_order','=',False)]}"/>
      </xpath>

    </field>
  </record>


    <!-- Actions for Sale Orders -->
    <record id="sale.action_orders_to_invoice" model="ir.actions.act_window">
        <field name="domain">[('invoice_status', '=', 'to invoice'), ('master_sale_order', '=', False)]</field>
    </record>

    <record id="action_sale_order_master" model="ir.actions.act_window">
        <field name="name">Master Sale Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="domain">[('master_sale_order', '=', True)]</field>
        <field name="context">{'default_master_sale_order': True, 'is_master_order': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'tree', 'view_id': ref('sale.view_quotation_tree')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_sale_order_unified_form')}),
                                      (0, 0, {'view_mode': 'kanban', 'view_id': ref('sale.view_sale_order_kanban')})]"/>
    </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('master_sale_order', '=', False)]</field>
        <field name="context">{'default_master_sale_order': False, 'is_master_order': False, 'search_default_my_quotation': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'tree', 'view_id': ref('sale.view_quotation_tree')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_sale_order_unified_form')}),
                                      (0, 0, {'view_mode': 'kanban', 'view_id': ref('sale.view_sale_order_kanban')})]"/>
    </record>

    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="context">{'default_master_sale_order': False, 'is_master_order': False}</field>
        <field name="domain">[('master_sale_order', '=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
                                      (0, 0, {'view_mode': 'tree', 'view_id': ref('sale.view_order_tree')}),
                                      (0, 0, {'view_mode': 'form', 'view_id': ref('view_sale_order_unified_form')}),
                                      (0, 0, {'view_mode': 'kanban', 'view_id': ref('sale.view_sale_order_kanban')})]"/>
    </record>

    <!-- Menu for Master Sale Orders -->
    <menuitem id="menu_sale_order_master"
              action="action_sale_order_master"
              parent="sale.sale_order_menu"
              sequence="1"
              groups="sales_team.group_sale_salesman"/>

    <!-- Search View for Sale Order Lines -->
    <record id="sale_order_line_search" model="ir.ui.view">
        <field name="name">sale_management.order.line.search</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <search string="Sale Order Lines">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="order_partner_id"/>
                <field name="salesman_id"/>
                <group expand="1" string="Group By">
                    <filter string="Order" name="order" context="{'group_by':'order_id'}"/>
                    <filter string="Customer" name="customer" context="{'group_by':'order_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View for Master Sale Order Lines -->
    <record id="view_sale_order_line_master_tree" model="ir.ui.view">
        <field name="name">sale.order.line.master.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Master Sale Order Lines" create="false" edit="false" delete="false">
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_uom_qty"/>
                <field name="product_uom_qty_total"/>
                <field name="remaining_product_qty"/>
                <field name="qty_delivered_total"/>
                <field name="qty_invoiced_total"/>
                <field name="product_uom"/>
                <field name="price_unit"/>
                <field name="tax_id" widget="many2many_tags"/>
                <field name="discount" groups="product.group_discount_per_so_line"/>
                <field name="price_subtotal"/>
                <field name="product_uom_category_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Tree View for Normal Sale Order Lines -->
    <record id="view_sale_order_line_normal_tree" model="ir.ui.view">
        <field name="name">sale.order.line.normal.tree</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <tree string="Sale Order Lines" create="false" edit="false" delete="false">
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_uom_qty"/>
                <field name="qty_delivered"/>
                <field name="qty_invoiced"/>
                <field name="product_uom"/>
                <field name="price_unit"/>
                <field name="tax_id" widget="many2many_tags"/>
                <field name="discount" groups="product.group_discount_per_so_line"/>
                <field name="price_subtotal"/>
                <field name="product_uom_category_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Action for Master Sale Order Line Balances -->
    <record id="action_sale_order_line_master" model="ir.actions.act_window">
        <field name="name">Master Sale Orders Balance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_sale_order_line_master_tree"/>
        <field name="domain">[('order_id.master_sale_order', '=', True)]</field>
        <field name="context">{'search_default_group_by_customer': True, 'search_default_group_by_order': True, 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <!-- Menu for Master Sale Order Line Balances -->
    <menuitem id="menu_sale_order_line_master"
              action="action_sale_order_line_master"
              parent="sale.menu_sale_report"
              sequence="10"
              groups="sales_team.group_sale_salesman"/>

    <!-- Action for Orphan Sale Order Lines -->
    <record id="action_sale_order_line_no_master" model="ir.actions.act_window">
        <field name="name">Orphan Sale Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_sale_order_line_normal_tree"/>
        <field name="domain">[('order_id.master_sale_order', '=', False), ('parent_id', '=', False)]</field>
        <field name="context">{'search_default_group_by_customer': True, 'search_default_group_by_order': True, 'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <!-- Menu for Orphan Sale Orders -->
    <menuitem id="menu_sale_order_line_no_master"
              action="action_sale_order_line_no_master"
              parent="sale.menu_sale_report"
              sequence="10"
              groups="sales_team.group_sale_salesman"/>
</odoo>