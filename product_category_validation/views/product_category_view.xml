<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Vista de categoría: tabla de reglas de validación -->
    <record id="product_category_validation_view_for_form" model="ir.ui.view">
        <field name="name">product.category.validation.view</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position='after'>
                <label for="is_kit"/>
                <field name="is_kit"/>
                <field name='validation_ids'>
                    <tree editable="bottom">
                        <field name='field_id'/>
                        <field name='make_required'/>
                        <field name='value' invisible="hide_field"/>
                        <field name='error_msg' required="True"/>
                        <field name='hide_field' column_invisible="1"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>

    <!-- Vista de producto: campo para ignorar validación -->
    <record id="product_template_bypass_validation_view" model="ir.ui.view">
        <field name="name">product.template.bypass.validation.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="bypass_validation"
                       widget="boolean_toggle"
                       string="Ignorar validación de categoría"/>
                <div class="alert alert-warning"
                     role="alert"
                     invisible="not bypass_validation">
                    <i class="fa fa-exclamation-triangle"/> Este producto no está sujeto a las restricciones de su categoría.
                </div>
            </field>
        </field>
    </record>

</odoo>
