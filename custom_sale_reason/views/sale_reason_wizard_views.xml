<odoo>
  <record id="view_sale_reason_wizard_form" model="ir.ui.view">
    <!-- Nombre interno de la vista -->
    <field name="name">sale.reason.wizard.form</field>
    <!-- Modelo al que aplica -->
    <field name="model">sale.reason.wizard</field>
    <!-- Definición de la vista -->
    <field name="arch" type="xml">
      <form string="Motivo de cambio de estado">
        <group>
          <!-- Estado destino, readonly -->
          <field name="next_state" readonly="1"/>
          <!-- Motivo específico, solo para confirmed o cancel -->
          <field name="specific_reason_id"
                 modifiers="{
                   'invisible': [('next_state','not in',('confirmed','cancel'))]
                 }"
          />
          <!-- Descripción libre -->
          <field name="reason"/>
        </group>
        <footer>
          <button string="Aplicar"
                  type="object"
                  name="apply_reason"
                  class="btn-primary"/>
          <button string="Cancelar"
                  class="btn-secondary"
                  special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
