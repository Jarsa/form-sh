  </record>
  <record id="sale_reason_opt_precio_cancel" model="sale.reason.option">
    <field name="code">precio</field>
    <field name="name">Precio</field>
    <field name="state">cancel</field>
  </record>
  <record id="sale_reason_opt_tiempo_cancel" model="sale.reason.option">
    <field name="code">tiempo_entrega</field>
    <field name="name">Tiempo de entrega</field>
    <field name="state">cancel</field>
  </record>
  <record id="sale_reason_opt_solucion_cancel" model="sale.reason.option">
    <field name="code">solucion_ingenieria</field>
    <field name="name">Solución de ingeniería</field>
    <field name="state">cancel</field>
  </record>
</odoo>
