<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="print_check_banorte">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <div t-att-data-oe-model="o._name" t-att-data-oe-id="o.id"  t-foreach="o.get_pages()" t-as="page" class="page article" t-attf-style="font-size: 8pt;">
                <t t-call="l10n_mx_check_printing.banorte_check" />
            </div>
        </t>
    </t>
</template>

<record id="action_print_check_banorte" model="ir.actions.report">
    <field name="name">Print Check Banorte</field>
    <field name="model">account.payment</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_mx_check_printing.print_check_banorte</field>
    <field name="report_file">l10n_mx_check_printing.print_check_banorte</field>
    <field name="attachment">'check_'+(object.partner_id and object.partner_id.name or 'Internal')+'_'+(object.name)+'_banorte.pdf'</field>
    <field name="attachment_use">False</field>
    <field name="binding_view_types">list</field>
    <field name="paperformat_id" ref="l10n_mx_check_printing.paperformat_check_mx"/>
    <field name="print_report_name">'Check Banorte - %s' % (object.partner_id.name or '',)</field>
</record>

</odoo>
