<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

     <!-- Portal Access Rules -->
    <record id="account_payment_rule_portal" model="ir.rule">
        <field name="name">Portal Personal Account Payment</field>
        <field name="model_id" ref="model_account_payment" />
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="perm_unlink" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="False" />
    </record>

    <!-- Added entry type so that payments can be viewed from the portal /my/payment_complements -->
    <record id="rule_account_move_payment_portal" model="ir.rule">
        <field name="name">Account Move Payment Portal</field>
        <field name="model_id" ref="model_account_move" />
        <field
            name="domain_force"
        >[('message_partner_ids','child_of',[user.commercial_partner_id.id]), ('payment_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    </record>

</odoo>
