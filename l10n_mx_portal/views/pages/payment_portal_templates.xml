<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="portal_my_home_menu_payment"
        name="Portal layout : Payment Complements"
        inherit_id="portal.portal_breadcrumbs"
        priority="10"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'payment_complements'"
                t-attf-class="breadcrumb-item #{'active ' if not payment_complements else ''}"
            >
                Payment Complements
            </li>
        </xpath>
    </template>

    <template
        id="portal_my_home_payment"
        name="Payment Complement"
        customize_show="True"
        inherit_id="portal.portal_my_home"
        priority="45"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Payment Complements</t>
                <t t-set="url" t-value="'/my/payment_complements'" />
                <t t-set="placeholder_count" t-value="'payment_count'" />
            </t>
        </xpath>
    </template>

</odoo>
