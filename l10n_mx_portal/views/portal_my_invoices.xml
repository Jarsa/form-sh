<?xml version='1.0' encoding="utf-8" ?>
<odoo>

    <template id="portal_invoice_page" name="Download Zipped Invoice" inherit_id="account.portal_invoice_page">
        <xpath expr="//a[hasclass('o_download_btn')]" position="after">
            <t t-if="invoice._get_zipped_cfdi()">
                <div class="btn btn-secondary btn-group flex-grow-1 ml-1">
                    <a
                        class="text-white btn-download-zip-cfdi"
                        t-att-href="invoice.get_portal_url(report_type='zip', download=True)"
                        title="Download Zip"
                    >
                        <i class="fa fa-folder" />
                        Download Zip
                    </a>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
