<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="portal_my_invoices" inherit_id="account.portal_my_invoices" name="Download E-invoices">
        <xpath expr="//th[hasclass('text-right')]" position="attributes">
            <attribute name="class" add="col-md-3" separator=" " />
        </xpath>
        <xpath expr="//td[hasclass('text-right')]" position="after">
            <t t-set="enable_edi_buttons" t-value="bool(invoice._get_l10n_mx_edi_signed_edi_document())" />
            <td>
                <div class="btn-group pull-right">
                    <a
                        role="button"
                        t-att-href="('/send_invoice_mail/%s' % invoice.id) if enable_edi_buttons else '#'"
                        t-attf-class="btn btn-xs btn-primary #{'' if enable_edi_buttons else 'disabled'}"
                        title="Send by e-mail"
                        aria-label="Send by e-mail"
                        t-att-aria-disabled="str(not enable_edi_buttons).lower()"
                    >
                        <i class="fa fa-envelope" />
                    </a>
                    <a
                        role="button"
                        t-att-href="invoice.get_portal_url(report_type='edi', download=True) if enable_edi_buttons else '#'"
                        t-attf-class="btn btn-xs btn-primary #{'' if enable_edi_buttons else 'disabled'}"
                        title="Download XML"
                        aria-label="Download XML"
                        target="_blank"
                        t-att-aria-disabled="str(not enable_edi_buttons).lower()"
                    >
                        <i class="fa fa-download" />
                    </a>
                </div>
            </td>
        </xpath>
    </template>

    <template id="email_sent" name="Email Sent">
        <t t-call="portal.portal_layout">
            <t t-set="title">Invoices</t>
            <div id="wrap">
                <div class="container mb64">
                    <div class="col-md-8">
                        <div class="oe_structure">
                            <h3 class="alert alert-success">The invoice has been sent</h3>
                        </div>
                    </div>
                    <div id="o_my_sidebar" class="col-md-3 col-md-offset-1 o_my_sidebar">
                        <div class="o_my_details">
                            <h3 class="page-header">
                                Your Details
                                <a role="button" href="/my/home" class="btn btn-default btn-xs">Change</a>
                            </h3>
                            <div
                                t-field="user.partner_id"
                                t-options='{"widget": "contact", "fields": ["email", "phone", "address", "name"]}'
                            />
                        </div>
                    </div>
                    <div class="col-md-12 oe_structure" />
                </div>
            </div>
        </t>
    </template>

</odoo>
