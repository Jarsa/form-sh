<odoo>
<odoo>
    <template id="l10n_mx_edi_reports_assets" name="L10n MX EDI Reports Assets" inherit_id="web.assets_backend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/l10n_mx_edi_reports/static/src/js/account_reports.js"/>
        </xpath>
    </template>
<odoo>
    <!-- general ledger report templates -->
    <template id="new_line_template_general_ledger_report" inherit_id="account_reports.line_template" primary="True">
        <xpath expr="//div[hasclass('o_account_reports_domain_dropdown')]/*[last()]" position="before">
            <li t-if="line['caret_options'] != 'account.tax'" role="presentation"><a
                    role="menuitem"
                    tabindex="-1"
                    t-att-data-id="line['id']"
                    action="open_document"
                >View Journal Entry</a></li>
        </xpath>
    </template>
</odoo>
