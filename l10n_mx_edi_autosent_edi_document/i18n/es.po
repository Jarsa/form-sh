#. module: l10n_mx_edi_autosent_edi_document
#: model:mail.template,subject:l10n_mx_edi_autosent_edi_document.email_template_edi_invoice_signed
msgid "${object.company_id.name} Invoice (Ref ${object.name or \"n/a\"})"
msgstr "${object.company_id.name} Factura (Referencia ${object.name or \"n/a\"})"

#. module: l10n_mx_edi_autosent_edi_document
#: model:mail.template,body_html:l10n_mx_edi_autosent_edi_document.email_template_edi_invoice_signed
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Dear\n"
"        % if object.partner_id.parent_id:\n"
"            ${object.partner_id.name} (${object.partner_id.parent_id.name}),\n"
"        % else:\n"
"            ${object.partner_id.name},\n"
"        % endif\n"
"    </p>\n"
"    <p style=\"margin-top: 10px; padding: 0px;\">\n"
"        Here is your signed\n"
"        % if object.name:\n"
"            invoice <strong>${object.name}</strong>\n"
"        % else:\n"
"            invoice\n"
"        %endif\n"
"        % if object.invoice_origin:\n"
"            (with reference: ${object.invoice_origin})\n"
"        % endif\n"
"        amounting in <strong>${format_amount(object.amount_total, object.currency_id)}</strong>\n"
"        from ${object.company_id.name}.\n"
"    </p>\n"
"    <p style=\"margin-top: 10px; padding: 0px;\">\n"
"        Do not hesitate to contact us if you have any questions.\n"
"        % if object.invoice_user_id.signature:\n"
"            <br/>\n"
"            ${object.invoice_user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p style=\"margin: 0px; padding: 0px;\">\n"
"        Estimado\n"
"        % if object.partner_id.parent_id:\n"
"            ${object.partner_id.name} (${object.partner_id.parent_id.name}),\n"
"        % else:\n"
"            ${object.partner_id.name},\n"
"        % endif\n"
"    </p>\n"
"    <p style=\"margin-top: 10px; padding: 0px;\">\n"
"        Aquí está su\n"
"        % if object.name:\n"
"            factura firmada <strong>${object.name}</strong>\n"
"        % else:\n"
"            factura firmada\n"
"        %endif\n"
"        % if object.invoice_origin:\n"
"            (con referencia: ${object.invoice_origin})\n"
"        % endif\n"
"        con un importe total de <strong>${format_amount(object.amount_total, object.currency_id)}</strong>\n"
"        de ${object.company_id.name}.\n"
"    </p>\n"
"    <p style=\"margin-top: 10px; padding: 0px;\">\n"
"        No dude en contactarnos si tiene alguna pregunta.\n"
"        % if object.invoice_user_id.signature:\n"
"            <br/>\n"
"            ${object.invoice_user_id.signature | safe}\n"
"        % endif\n"
"    </p>\n"
"</div>\n"
"        "

