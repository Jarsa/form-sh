<?xml version="1.0" ?>
<odoo noupdate="1">
    <record id="ir_cron_mail_signed_invoice_scheduler_action" model="ir.cron">
        <field name="name">Signed Invoice Email Queue Manager</field>
        <field name="model_id" ref="account.model_account_move" />
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True" />
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')" />
        <field name="code">
# The parameters `limit` and `minute_delay` can also be send.
# The limit will say how many invoices will be sent and the delay correspond to the time range
# for the last change of each invoice.
model._cron_send_invoice_signed_mail()
        </field>
    </record>
</odoo>
